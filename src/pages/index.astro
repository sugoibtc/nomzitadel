---
import BaseLayout from '../layouts/BaseLayout.astro';
import ValuePropCard from '../components/v2/ValuePropCard.astro';
import BountyCard from '../components/v2/BountyCard.astro';
import BlogCard from '../components/BlogCard.astro';
import HeroButtons from '../components/v2/HeroButtons.jsx';
import HeroCarousel from '../components/v2/HeroCarousel.jsx';
import HeroText from '../components/v2/HeroText.jsx';
import VisionValues from '../components/v2/VisionValues.jsx';
import MatrixRain from '../components/v2/MatrixRain.jsx';
import ProjectCard from '../components/v2/ProjectCard.astro';
import projectsData from '../data/projects.json';

const activeProjects = projectsData.slice(0, 6); // Take first 6 for preview
const bounties = [
  {
    title: "Solve the Treasure Hunt",
    reward: "321 ZNN",
    difficulty: "Master",
    category: "Quest",
    link: "/treasure-hunt"
  }
];

const latestPosts = [
  {
    title: 'Why New Tokens? What Zenon Has to Do With Bitcoin',
    excerpt: 'The most common question from Bitcoiners. We break down why ZNN/QSR are essential for Bitcoin-native scaling.',
    date: '2026-02-20',
    category: 'BTC + Zenon',
    slug: 'btc-thesis-why-new-tokens',
    type: 'ANALYSIS',
    source: 'HC1 Forum'
  },
  {
    title: 'The Road to Phase Z: Scaling Decentralization',
    excerpt: 'A deep dive into the technical milestones required for the next evolution of NoM infrastructure.',
    date: '2026-02-21',
    category: 'Architecture',
    slug: 'zenon-phase-z',
    type: 'RECAP',
    source: 'Zenon ORG'
  },
  {
    title: 'Bitcoin Interpol: The Security of Dual-Ledger',
    excerpt: 'How Zenon leverages Bitcoin security without sacrificing the speed of a meta-DAG architecture.',
    date: '2026-02-22',
    category: 'Interoperability',
    slug: 'bitcoin-interpol',
    type: 'DIGEST',
    source: 'Medium'
  },
  {
    title: 'Plasma: The Infinite Fuel of Zenon',
    excerpt: 'Understanding the mechanics of feeless transactions through QSR fusion and resource management.',
    date: '2026-02-23',
    category: 'Protocol',
    slug: 'zenon-plasma-mechanics',
    type: 'TECHNICAL',
    source: 'HC1 Forum'
  },
  {
    title: 'The Role of Sentinel Nodes in Consensus',
    excerpt: 'More than just voters. Sentinels provide the decentralized heartbeat of the Network of Momentum.',
    date: '2026-02-24',
    category: 'Network',
    slug: 'sentinel-role-consensus',
    type: 'ANALYSIS',
    source: 'Zenon ORG'
  },
  {
    title: 'Supernova: The Universal Decentralized App Engine',
    excerpt: 'Why the next hardfork is the most important technical upgrade in Zenon history.',
    date: '2026-02-25',
    category: 'Hardfork',
    slug: 'supernova-upgrade-path',
    type: 'RECAP',
    source: 'Ecosystem'
  },
];
---

<BaseLayout title="NoM Zitadel | The Definitive Zenon Hub">
  <!-- Scroll Narrator Navigation (Fixed Side) -->
  <div class="fixed right-4 top-1/2 -translate-y-1/2 z-50 hidden lg:flex flex-col gap-6 opacity-0 pointer-events-none transition-all duration-1000" id="scroll-narrator">
     <div class="nav-dot active group cursor-pointer" data-target="hero">
        <div class="dot w-2 h-2 rounded-full bg-text-dim/30 group-hover:bg-text-dim group-[.active]:bg-neon-green group-[.active]:shadow-[0_0_12px_#6cef4b] group-[.active]:scale-150 transition-all"></div>
     </div>
     <div class="nav-dot group cursor-pointer" data-target="ecosystem">
        <div class="dot w-2 h-2 rounded-full bg-text-dim/30 group-hover:bg-text-dim group-[.active]:bg-neon-green group-[.active]:shadow-[0_0_12px_#6cef4b] group-[.active]:scale-150 transition-all"></div>
     </div>
     <div class="nav-dot group cursor-pointer" data-target="vision">
        <div class="dot w-2 h-2 rounded-full bg-text-dim/30 group-hover:bg-text-dim group-[.active]:bg-neon-green group-[.active]:shadow-[0_0_12px_#6cef4b] group-[.active]:scale-150 transition-all"></div>
     </div>
  </div>

  <!-- Section 1: Hero (Expanded & Optimized for Desktop) -->
  <section id="hero" class="w-full min-h-screen relative flex flex-col justify-center overflow-hidden cyber-grid z-30 pt-20 pb-20">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(17,255,68,0.05)_0%,transparent_60%))] pointer-events-none"></div>
    <div class="relative z-10 w-full px-6 sm:px-8 lg:px-12 transition-all duration-1000 flex-1 flex flex-col justify-center" data-animate>
       
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-20 xl:gap-32 items-start mt-12 mb-12">
          <!-- Left Column (~60% -> col-span-7) -->
          <div class="lg:col-span-7 flex flex-col items-center text-center lg:items-start lg:text-left xl:pr-8 relative">
            <HeroText client:load />
           
           <div class="hidden lg:block w-full mt-4">
             <HeroButtons client:load />
           </div>
          </div>

          <div class="hidden lg:flex lg:col-span-5 flex-col h-full min-h-[500px]">
              <HeroCarousel client:load />
          </div>
       </div>

    </div>


  </section>

  <!-- Section 2: Ecosystem (Articles & Bounties) -->
  <section id="ecosystem" class="w-full px-6 sm:px-8 lg:px-12 py-32 border-b border-white/5 scroll-mt-20 relative overflow-hidden">
    <div class="absolute right-0 top-1/2 w-full h-full bg-[radial-gradient(ellipse_at_center_right,rgba(108,239,75,0.03)_0%,transparent_50%))] pointer-events-none"></div>
    <div class="absolute left-1/2 bottom-0 -translate-x-1/2 w-full h-full bg-[radial-gradient(ellipse_at_bottom,rgba(108,239,75,0.05)_0%,transparent_50%))] pointer-events-none"></div>
    
    <div class="w-full grid grid-cols-1 xl:grid-cols-12 gap-16 xl:gap-24 relative z-10">
      
      <!-- Left Side: Latest Articles -->
      <div class="xl:col-span-6 flex flex-col">
        <div class="bg-black/40 backdrop-blur-md p-6 sm:p-8 rounded-xl border border-white/10 flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-6 opacity-0 translate-y-8 transition-all duration-700 hover:border-neon-green/30 relative overflow-hidden group/header cyber-grid" data-animate>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(17,255,68,0.1)_0%,transparent_70%))] pointer-events-none"></div>
          <div class="max-w-xl relative z-10">
            <h2 class="text-3xl md:text-4xl font-bold text-text-bright mb-2 tracking-tight"><span class="text-neon-green">Latest</span> Articles</h2>
            <p class="text-text-dim text-lg">Curated intelligence from the Zenon ecosystem.</p>
          </div>
          <a href="/blog" class="relative z-10 inline-flex items-center text-neon-green font-semibold hover:text-text-bright transition-colors group whitespace-nowrap">
            All Articles
            <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
        
        <!-- 2x2 Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 opacity-0 translate-y-12 transition-all duration-1000 delay-200" data-animate>
          {latestPosts.slice(0, 4).map((post) => (
            <div class="transform origin-top-left flex flex-col h-full">
              <BlogCard {...post} />
            </div>
          ))}
        </div>
      </div>

      <!-- Right Side: Start Contributing -->
      <div class="xl:col-span-6 flex flex-col">
        <!-- Dashboard Header -->
        <div class="bg-black/40 backdrop-blur-md p-6 sm:p-8 rounded-xl border border-white/10 flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-6 opacity-0 translate-y-8 transition-all duration-700 hover:border-neon-green/30 relative overflow-hidden group/header cyber-grid" data-animate>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(17,255,68,0.05)_0%,transparent_60%))] pointer-events-none"></div>
          <div class="relative z-10">
            <h2 class="text-3xl md:text-4xl font-black text-text-bright mb-2 tracking-tight">
              Start <span class="text-neon-green text-glow">Contributing</span>
            </h2>
            <p class="text-text-dim text-lg leading-relaxed">
              Earn ZNN by contributing to high-impact 
              <span class="text-neon-green font-bold text-glow">MicroWorkz</span>.
            </p>
          </div>

          <!-- Legend -->
          <div class="flex items-center gap-4 self-start sm:self-auto shrink-0 relative z-10">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-neon-green shadow-[0_0_8px_#6cef4b]"></span>
              <span class="text-[10px] font-black text-text-dim uppercase tracking-[0.2em]">Active</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#f7931a] shadow-[0_0_8px_#f7931a]"></span>
              <span class="text-[10px] font-black text-text-dim uppercase tracking-[0.2em]">On Hold</span>
            </div>
          </div>
        </div>

        <!-- 2x2 Grid of Bounties -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-12 opacity-0 translate-y-8 transition-all duration-1000 delay-200" data-animate>
          {bounties.slice(0, 1).map((bounty) => (
             <BountyCard {...bounty} />
          ))}
          {/* Empty + Slots (Hidden on Mobile for brevity) */}
          {Array(3).fill(null).map(() => (
            <a href="#" class="hidden sm:flex h-full min-h-[160px] rounded-xl border border-white/5 bg-gradient-to-br from-white/5 to-transparent items-center justify-center hover:bg-white/10 transition-all duration-300 group">
              <span class="text-4xl text-white/20 font-light group-hover:text-neon-green group-hover:scale-125 transition-transform duration-300 group-hover:drop-shadow-[0_0_10px_rgba(17,255,68,0.5)]">+</span>
            </a>
          ))}
        </div>

        <!-- Active Initiatives Header -->
        <div class="bg-black/40 backdrop-blur-md p-6 sm:p-8 rounded-xl border border-white/10 flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-6 opacity-0 translate-y-8 transition-all duration-700 delay-300 hover:border-neon-green/30 relative overflow-hidden group/header cyber-grid" data-animate>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(17,255,68,0.1)_0%,transparent_70%))] pointer-events-none"></div>
          <div class="relative z-10">
            <h2 class="text-2xl lg:text-3xl font-black text-text-bright mb-1 tracking-tight">
              <span class="text-neon-green">Active</span> Initiatives
            </h2>
            <p class="text-text-dim text-sm">High-impact network development projects.</p>
          </div>
          <a href="/projects" class="relative z-10 text-xs text-neon-green hover:text-white uppercase tracking-widest font-bold whitespace-nowrap">View All →</a>
        </div>

        <!-- 2x2 Grid of Initiatives -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 opacity-0 translate-y-8 transition-all duration-1000 delay-400" data-animate>
           {activeProjects.slice(0, 4).map((project) => (
              <ProjectCard {...project} />
           ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Section 4: Vision & Values -->
  <section id="vision" class="w-full relative flex items-center justify-center pt-16 pb-32 z-30 border-b border-white/5 scroll-mt-20">
    <div class="absolute inset-0 cyber-grid opacity-10 pointer-events-none"></div>
    <div class="absolute left-0 top-0 w-full h-full bg-[radial-gradient(ellipse_at_center_left,rgba(108,239,75,0.03)_0%,transparent_50%))] pointer-events-none"></div>
    
    <div class="px-6 sm:px-8 lg:px-12 w-full grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24 items-start">
       
       <!-- Left Side: Matrix Rain Treasure Hunt Portal -->
       <div class="lg:col-span-4 xl:col-span-5 flex flex-col gap-8 opacity-0 translate-y-8 transition-all duration-1000 w-full" data-animate>
         <MatrixRain client:only="react" />
         
         <!-- Taproot Activation Card -->
         <div class="flex justify-center">
           <a href="/treasure-hunt" class="group px-8 py-5 border border-[#FF9900]/30 bg-black/60 backdrop-blur-md rounded-xl transform transition-all duration-300 hover:-translate-y-1 hover:border-[#FF9900] hover:bg-black/80 text-center relative overflow-hidden shadow-[0_10px_30px_-10px_rgba(255,153,0,0.2)]">
             <div class="absolute inset-0 bg-gradient-to-br from-[#FF9900]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
             <div class="relative z-10">
               <span class="block text-[10px] text-[#FF9900] font-mono tracking-[0.3em] font-bold mb-1 opacity-90 animate-pulse">
                 BLOCK #709,632
               </span>
               <h3 class="text-xl sm:text-2xl font-black text-white tracking-widest uppercase mb-2 [text-shadow:0_0_12px_rgba(255,153,0,0.6)]">
                 Taproot Activation
               </h3>
               <span class="inline-flex items-center gap-2 text-[10px] font-mono text-gray-300 group-hover:text-white transition-colors uppercase tracking-[0.1em] font-bold">
                 Enter Treasure Hunt 
                 <span class="text-[#FF9900] group-hover:translate-x-1 transition-transform">→</span>
               </span>
             </div>
           </a>
         </div>
       </div>

       <!-- Right Side: Vision & Values Text -->
       <div class="lg:col-span-8 xl:col-span-7 flex flex-col py-8">
         
         <!-- Vision Block -->
         <div class="mb-24 opacity-0 translate-x-[20px] transition-all duration-1000 delay-200" data-animate>
           <div class="inline-flex items-center gap-2 mb-6 text-text-dim/80 text-xs font-mono font-bold tracking-[0.2em] uppercase">
             <span class="text-neon-green">↑</span> VISION
           </div>
           
           <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-medium text-text-bright mb-8 leading-[1.2] tracking-tight">
             Zenon is building the foundation for a <br class="hidden xl:block"/>
             <span class="text-neon-green font-black">sovereign, feeless, and Bitcoin-aligned</span> network.
           </h2>
           
           <p class="text-lg text-text-dim/90 leading-relaxed max-w-2xl font-light">
             Network of Momentum is a dual-ledger, dual-coin protocol anchored to Bitcoin's proof-of-work — designed for a world where financial infrastructure should be open, permissionless, and owned by no one.
           </p>
         </div>

         <!-- Values Section injected via Framer Motion Component -->
         <VisionValues client:visible />

       </div>
    </div>
  </section>


</BaseLayout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* Utility classes triggered by JS IntersectionObserver */
  .animate-in {
    opacity: 1 !important;
    transform: translateY(0) scale(1) !important;
    filter: blur(0px) !important;
  }
</style>

<script>
  // Intersection Observer for scroll-driven animations and Side Nav updates
  const sections = document.querySelectorAll('section, footer');
  const navDots = document.querySelectorAll('.nav-dot');
  const narrator = document.getElementById('scroll-narrator');
  
  let isScrolling;
  let scrollInTimeout;

  window.addEventListener('scroll', () => {
    if (!narrator) return;

    // Fade in with slight delay if not already visible
    if (!narrator.classList.contains('opacity-100')) {
      clearTimeout(scrollInTimeout);
      scrollInTimeout = setTimeout(() => {
        narrator.classList.remove('opacity-0', 'pointer-events-none');
        narrator.classList.add('opacity-100', 'pointer-events-auto');
      }, 300); // 300ms delay to fade in
    }

    // Clear previous timeout and set new one to fade out
    window.clearTimeout(isScrolling);
    isScrolling = setTimeout(() => {
      narrator.classList.remove('opacity-100', 'pointer-events-auto');
      narrator.classList.add('opacity-0', 'pointer-events-none');
    }, 1500); // Fade out 1.5s after scrolling stops
  }, { passive: true });

  if (sections.length) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          // 1. Update side navigation active state
          if (entry.target.tagName.toLowerCase() !== 'footer') {
            navDots.forEach(dot => {
              if (dot.getAttribute('data-target') === entry.target.id) {
                dot.classList.add('active');
              } else {
                dot.classList.remove('active');
              }
            });
          }

          // 2. Trigger text/card animations inside the section
          const elementsToAnimate = entry.target.querySelectorAll('[data-animate]');
          elementsToAnimate.forEach(el => el.classList.add('animate-in'));
        }
      });
    }, {
      root: null, // use viewport
      threshold: 0.05, // Trigger when 5% of the section is visible to ensure it fires on tall mobile sections
      rootMargin: "0px 0px -50px 0px"
    });

    sections.forEach(section => observer.observe(section));

    // Side navigation click scroll
    navDots.forEach(dot => {
      dot.addEventListener('click', () => {
        const targetId = dot.getAttribute('data-target');
        const targetSection = document.getElementById(targetId);
        if (targetSection) {
          const y = targetSection.getBoundingClientRect().top + window.scrollY - 80;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
      });
    });
  }
</script>
