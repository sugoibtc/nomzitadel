---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import BlogCard from '../components/BlogCard.astro';

const features = [
  {
    icon: 'learn',
    title: 'Learn NoM',
    description: 'Understand the Network of Momentum from the ground up — architecture, consensus, and design philosophy.',
    href: '/learn',
  },
  {
    icon: 'bitcoin',
    title: 'Bitcoin + Zenon',
    description: 'Discover how Zenon builds alongside Bitcoin with trustless SPV interoperability — no wrapped tokens, no custodians.',
    href: '/learn/bitcoin',
  },
  {
    icon: 'community',
    title: 'Community',
    description: 'Connect with builders, researchers, and enthusiasts across forums, Telegram, and X.',
    href: '/community',
  },
  {
    icon: 'build',
    title: 'Build on Zenon',
    description: 'Access SDKs, documentation, and funding through Accelerator-Z to build the future of decentralized infrastructure.',
    href: '/build',
  },
];

const stats = [
  { label: 'Feeless Transactions', description: 'Powered by Plasma from QSR fusion' },
  { label: 'Dual-Ledger Architecture', description: 'Block-lattice meets meta-DAG' },
  { label: 'Bitcoin-Native', description: 'Trustless SPV interoperability' },
];

const latestPosts = [
  {
    title: 'Why New Tokens? What Zenon Has to Do With Bitcoin',
    excerpt: 'The most common question from Bitcoiners. Here is why ZNN and QSR exist and how they serve Bitcoin — not compete with it.',
    date: '2026-02-20',
    category: 'BTC + Zenon',
    slug: 'btc-thesis-why-new-tokens',
  },
  {
    title: 'Dual-Ledger Architecture: What Makes Zenon Different',
    excerpt: 'Block-lattice meets meta-DAG. Here is what that actually means and why it matters.',
    date: '2026-02-21',
    category: 'Architecture & Tech',
    slug: 'zenon-dual-ledger',
  },
  {
    title: 'The Bear Market Is Where Real Ones Build',
    excerpt: 'Everyone left. The builders stayed. Here is what is happening in Zenon while the market looks away.',
    date: '2026-02-22',
    category: 'Bear Market',
    slug: 'bear-market-builders',
  },
];
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="relative overflow-hidden cyber-grid pt-24 pb-32">
    <div class="absolute inset-0 bg-gradient-to-b from-neon-green/10 to-transparent pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-4xl mx-auto">
        <div class="inline-block px-4 py-1 rounded-full border border-neon-green/30 bg-neon-green/5 text-neon-green text-sm font-medium mb-6 backdrop-blur-sm animate-pulse">
          Network of Momentum • 7 Years of Evolution
        </div>
        <h1 class="text-5xl md:text-8xl font-bold text-white mb-6 leading-tight tracking-tight">
          Stay ahead of the <span class="text-neon-green text-glow">momentum</span>
        </h1>
        <p class="text-xl md:text-2xl text-pistachio/80 mb-10 max-w-2xl mx-auto">
          Never miss a momentum. The definitive resource hub for Zenon, the Network of Momentum — research, documentation, and ecosystem resources in one place.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center">
          <a
            href="/build"
            class="group relative inline-flex items-center justify-center px-8 py-4 bg-neon-green text-bg font-bold rounded-sm hover:-translate-y-1 transition-all"
          >
            <span class="relative z-10 inline-flex items-center">
              Start Building
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </span>
            <!-- Subtle animated dots line under CTA text -->
            <div
              class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-1 h-[2px] w-24 opacity-40 mix-blend-overlay group-hover:opacity-70 group-hover:scale-110 transition-transform transition-opacity duration-300"
              style="background-image: radial-gradient(rgba(0,0,0,0.6) 1px, transparent 1px); background-size: 12px 12px; animation: dots-move 8s linear infinite"
            ></div>
          </a>
          <a
            href="/research"
            class="inline-flex items-center justify-center px-10 py-4 border border-neon-green/50 text-neon-green font-bold rounded-sm hover:bg-neon-green/10 transition-all backdrop-blur-sm"
          >
            Browse Research
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Cards -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature) => (
        <FeatureCard {...feature} />
      ))}
    </div>
  </section>

  <!-- Stats Row / USPs -->
  <section class="border-y border-neon-green/10 bg-card/50 backdrop-blur-sm backdrop-blur-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
        {stats.map((stat) => (
          <div class="group">
            <h3 class="text-2xl font-bold text-neon-green mb-3 group-hover:text-glow transition-all">{stat.label}</h3>
            <p class="text-text-dim leading-relaxed">{stat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Posts -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="flex items-center justify-between mb-12">
      <h2 class="text-3xl font-bold text-white tracking-tight">Latest from <span class="text-neon-green">NoM Zitadel</span></h2>
      <a href="/blog" class="text-neon-green hover:text-white transition-colors font-medium border-b border-neon-green/30 pb-1">
        View all &rarr;
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {latestPosts.map((post) => (
        <BlogCard {...post} />
      ))}
    </div>
  </section>
</BaseLayout>
