---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ValuePropCard from '../../components/v2/ValuePropCard.astro';
---

<BaseLayout title="Home v3 - Zenon Vertical Narrative">
  <!-- Scroll Narrator Navigation (Fixed Side) -->
  <div class="fixed right-8 top-1/2 -translate-y-1/2 z-50 hidden lg:flex flex-col gap-6" id="scroll-narrator">
     <div class="nav-dot active group" data-target="section-btc">
        <span class="text-sm font-bold text-white opacity-0 group-hover:opacity-100 transition-all translate-x-4 group-hover:translate-x-0 group-[.active]:opacity-100 group-[.active]:translate-x-0 group-[.active]:text-[#f7931a]">The Foundation</span>
        <div class="dot w-2 h-2 rounded-full bg-white/30 group-hover:bg-white group-[.active]:bg-[#f7931a] group-[.active]:shadow-[0_0_12px_#f7931a] group-[.active]:scale-150 transition-all"></div>
     </div>
     <div class="nav-dot group" data-target="section-portal">
        <span class="text-sm font-bold text-white opacity-0 group-hover:opacity-100 transition-all translate-x-4 group-hover:translate-x-0 group-[.active]:opacity-100 group-[.active]:translate-x-0 group-[.active]:text-[#3EB489]">Zenon Portal</span>
        <div class="dot w-2 h-2 rounded-full bg-white/30 group-hover:bg-white group-[.active]:bg-[#3EB489] group-[.active]:shadow-[0_0_12px_#3EB489] group-[.active]:scale-150 transition-all"></div>
     </div>
     <div class="nav-dot group" data-target="section-zitadel">
        <span class="text-sm font-bold text-white opacity-0 group-hover:opacity-100 transition-all translate-x-4 group-hover:translate-x-0 group-[.active]:opacity-100 group-[.active]:translate-x-0 group-[.active]:text-neon-green">The Zitadel</span>
        <div class="dot w-2 h-2 rounded-full bg-white/30 group-hover:bg-white group-[.active]:bg-neon-green group-[.active]:shadow-[0_0_12px_#6cef4b] group-[.active]:scale-150 transition-all"></div>
     </div>
     <div class="nav-dot group" data-target="section-core">
        <span class="text-sm font-bold text-white opacity-0 group-hover:opacity-100 transition-all translate-x-4 group-hover:translate-x-0 group-[.active]:opacity-100 group-[.active]:translate-x-0 group-[.active]:text-neon-green">Core Network</span>
        <div class="dot w-2 h-2 rounded-full bg-white/30 group-hover:bg-white group-[.active]:bg-neon-green group-[.active]:shadow-[0_0_12px_#6cef4b] group-[.active]:scale-150 transition-all"></div>
     </div>
  </div>

  <!-- Smooth Snap Container -->
  <main class="absolute inset-0 pt-16 h-screen w-full overflow-y-auto overflow-x-hidden snap-y snap-mandatory scroll-smooth z-10" id="scroll-container">
    
    <!-- SECTION 1: Bitcoin Foundation (Amber / Orange) -->
    <section id="section-btc" class="snap-start snap-always w-full min-h-screen relative flex items-center justify-center bg-black overflow-hidden z-20">
      <!-- Background Glow -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(247,147,26,0.1)_0%,transparent_50%))]"></div>
      
      <!-- Grid/Mesh -->
      <div class="absolute bottom-0 w-full h-1/2 flex items-end justify-center pointer-events-none opacity-60">
         <div class="w-[200%] h-48 [perspective:800px]">
            <div class="w-full h-full [transform:rotateX(75deg)_translateY(-50px)] bg-[linear-gradient(transparent_0px,transparent_49px,rgba(247,147,26,0.2)_50px),linear-gradient(90deg,transparent_0px,transparent_49px,rgba(247,147,26,0.2)_50px)] bg-[size:50px_50px]"></div>
         </div>
      </div>
      
      <!-- Content -->
      <div class="relative z-10 text-center px-4 max-w-4xl opacity-0 translate-y-8 blur-sm transition-all duration-[1200ms]" data-animate>
        <div class="inline-block px-3 py-1 border border-[#f7931a]/50 rounded text-[#f7931a] text-xs font-bold tracking-[0.2em] mb-6">THE FOUNDATION</div>
        <h2 class="text-5xl md:text-8xl font-black text-white mb-6 tracking-tight">Secured by <br/><span class="text-[#f7931a] drop-shadow-[0_0_15px_rgba(247,147,26,0.5)]">Bitcoin</span></h2>
        <p class="text-xl md:text-2xl text-text-dim max-w-2xl mx-auto">The most secure network in existence. Decentralization without compromise.</p>
        <div class="mt-12 animate-bounce opacity-50">
           <svg class="w-6 h-6 mx-auto text-[#f7931a]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
        </div>
      </div>
    </section>

    <!-- SECTION 2: Zenon Portal (The Bridge) -->
    <section id="section-portal" class="snap-start snap-always w-full min-h-screen relative flex items-center justify-center bg-[#050505] overflow-hidden scroll-mt-0 z-30">
      
      <!-- Portal Gradient Background -->
      <div class="absolute inset-0 bg-gradient-to-b from-black via-transparent to-[#1a2f22]"></div>

      <!-- Portal Threads Animation -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 transition-opacity duration-[1500ms]" id="portal-threads">
         <!-- Center portal ring -->
         <div class="w-96 h-96 border-[0.5px] border-neon-green/30 rounded-full absolute rotate-x-75 animate-[spin_10s_linear_infinite] [box-shadow:inset_0_0_50px_rgba(108,239,75,0.1)]"></div>
         <div class="w-64 h-64 border border-neon-green/50 rounded-full absolute rotate-x-75 animate-[spin_8s_linear_infinite_reverse] [box-shadow:0_0_30px_rgba(108,239,75,0.3)]"></div>
         <!-- Vertical rays -->
         <div class="absolute w-[1px] h-[150vh] bg-gradient-to-t from-[#f7931a] via-[#3EB489] to-[#6cef4b] blur-[1px]"></div>
         <div class="absolute w-[2px] h-[100vh] ml-24 bg-gradient-to-t from-transparent via-[#6cef4b] to-transparent opacity-50 blur-[2px] animate-pulse"></div>
         <div class="absolute w-[2px] h-[100vh] -ml-24 bg-gradient-to-t from-transparent via-[#3EB489] to-transparent opacity-50 blur-[2px] animate-[pulse_3s_infinite]"></div>
      </div>

      <!-- Content -->
      <div class="relative z-10 text-center px-4 max-w-4xl opacity-0 translate-y-8 blur-sm transition-all duration-[1200ms] delay-300" data-animate>
        <div class="inline-block px-3 py-1 border border-[#3EB489]/50 rounded text-[#3EB489] text-xs font-bold tracking-[0.2em] mb-6">THE BRIDGE</div>
        <h2 class="text-5xl md:text-8xl font-black text-white mb-6 tracking-tight">The Zenon <br/><span class="text-[#3EB489] drop-shadow-[0_0_20px_rgba(62,180,137,0.5)]">Portal</span></h2>
        <p class="text-xl md:text-2xl text-text-dim max-w-2xl mx-auto">Trustless SPV interoperability linking the dual-ledger directly to Bitcoin. No custodians. No wrapped tokens.</p>
        <div class="mt-12 animate-bounce opacity-50">
           <svg class="w-6 h-6 mx-auto text-[#3EB489]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
        </div>
      </div>
    </section>

    <!-- SECTION 3: The Zitadel Switchboard -->
    <section id="section-zitadel" class="snap-start snap-always w-full min-h-screen relative flex items-center justify-center bg-black overflow-hidden cyber-grid z-40">
      
      <!-- Content Layer -->
      <div class="relative z-10 w-full max-w-5xl mx-4 opacity-0 scale-95 blur-sm transition-all duration-[1200ms] delay-200" data-animate>
        <!-- The Floating Switchboard Glass Panel -->
        <div class="bg-card/40 backdrop-blur-2xl rounded-2xl p-8 md:p-14 border border-neon-green/30 shadow-[0_0_80px_rgba(108,239,75,0.15)] relative overflow-hidden animate-[float_6s_ease-in-out_infinite]">
           
           <div class="absolute inset-0 bg-gradient-to-br from-neon-green/5 to-transparent pointer-events-none"></div>

           <!-- Terminal Header -->
           <div class="flex justify-between items-start mb-10 border-b border-white/10 pb-6 relative z-10">
              <div class="flex items-center gap-4">
                 <div class="h-2 w-2 rounded-full bg-red-500"></div>
                 <div class="h-2 w-2 rounded-full bg-yellow-500"></div>
                 <div class="h-2 w-2 rounded-full bg-neon-green animate-pulse shadow-[0_0_10px_#6cef4b]"></div>
              </div>
              <div class="text-xs font-mono text-neon-green/80 flex items-center gap-2">
                 <svg class="w-4 h-4 animate-spin-slow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                 SYNCING MOMENTUM...
              </div>
           </div>

           <div class="relative z-10 text-center">
             <div class="inline-block px-3 py-1 bg-neon-green/10 text-neon-green text-xs font-bold tracking-[0.2em] rounded mb-6">THE DESTINATION</div>
             <h1 class="text-5xl md:text-7xl font-black text-white mb-6">
               Building the <span class="text-neon-green text-glow border-b-4 border-neon-green">Zitadel</span>
             </h1>
             <p class="text-xl md:text-2xl text-text-dim mb-10 max-w-2xl mx-auto leading-relaxed">
               The central intelligence switchboard for fragmented momentum protocols. The Last Line of Truth.
             </p>

             <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10 max-w-3xl mx-auto">
               <div class="border border-neon-green/20 bg-black/60 p-4 rounded-lg shadow-[inset_0_0_20px_rgba(108,239,75,0.05)] hover:bg-neon-green/5 transition-colors">
                 <div class="text-neon-green text-lg font-mono mb-1">01</div>
                 <div class="text-sm font-bold text-white tracking-widest">FEELESS</div>
               </div>
               <div class="border border-neon-green/20 bg-black/60 p-4 rounded-lg shadow-[inset_0_0_20px_rgba(108,239,75,0.05)] hover:bg-neon-green/5 transition-colors">
                 <div class="text-neon-green text-lg font-mono mb-1">02</div>
                 <div class="text-sm font-bold text-white tracking-widest">NATIVE</div>
               </div>
               <div class="border border-neon-green/20 bg-black/60 p-4 rounded-lg shadow-[inset_0_0_20px_rgba(108,239,75,0.05)] hover:bg-neon-green/5 transition-colors">
                 <div class="text-neon-green text-lg font-mono mb-1">03</div>
                 <div class="text-sm font-bold text-white tracking-widest">ON-CHAIN</div>
               </div>
             </div>

             <div class="flex flex-col sm:flex-row gap-6 justify-center">
               <a href="/build" class="group relative px-8 py-4 bg-neon-green text-black font-bold text-lg rounded hover:shadow-[0_0_30px_rgba(108,239,75,0.5)] transition-all overflow-hidden">
                 <span class="relative z-10">Start Building</span>
                 <div class="absolute inset-0 w-full h-full bg-white/20 -translate-x-full group-hover:translate-x-0 transition-transform duration-300 ease-out skew-x-12"></div>
               </a>
               <a href="/research" class="px-8 py-4 border border-neon-green/50 text-neon-green font-bold text-lg rounded hover:bg-neon-green/10 transition-all">Explore Research</a>
             </div>
           </div>
        </div>
      </div>
      
      <div class="absolute bottom-12 w-full text-center animate-bounce opacity-50 z-10">
         <svg class="w-6 h-6 mx-auto text-neon-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
      </div>
    </section>

    <!-- SECTION 4: What & Why (Core Network) -->
    <section id="section-core" class="snap-start snap-always w-full min-h-screen relative flex items-center justify-center bg-[#030504] py-24 z-50 border-t border-white/5">
      <div class="max-w-7xl mx-auto px-4 w-full">
         <div class="text-center mb-16 opacity-0 translate-y-8 blur-[2px] transition-all duration-1000" data-animate>
           <h2 class="text-4xl md:text-6xl font-bold text-white mb-4">Why Build on <span class="text-neon-green">Zenon</span>?</h2>
           <p class="text-xl text-text-dim max-w-2xl mx-auto">The architectural choices that separate the Network of Momentum from legacy infrastructure.</p>
         </div>

         <div class="grid grid-cols-1 md:grid-cols-3 gap-6 opacity-0 translate-y-12 transition-all duration-1000 delay-200" data-animate>
            <ValuePropCard 
              icon="⚡"
              title="Feeless by Design"
              description="Powered by Plasma — fuse QSR to generate transaction throughput. No gas wars, no fee spikes."
            />
            <ValuePropCard 
              icon="₿"
              title="Bitcoin-Native SPV"
              description="Trustless interoperability with Bitcoin at the protocol level. No bridges, no wrapping, no custodians."
            />
            <ValuePropCard 
              icon="💰"
              title="On-Chain Funding"
              description="Get funded directly by the protocol through Accelerator-Z. Submit a proposal, get community-backed ZNN."
            />
         </div>
         
         <div class="mt-20 flex justify-center pb-12">
             <a href="#section-btc" id="back-to-top" class="text-text-dim hover:text-neon-green transition-colors text-sm font-bold tracking-[0.1em] border-b border-white/10 pb-1">↑ RETURN TO SOURCE</a>
         </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  html, body {
    margin: 0;
    height: 100%;
    overflow: hidden; /* Prevent double scrollbars, keep scrolling inside main */
  }

  .cyber-grid {
    background-image: 
      linear-gradient(rgba(108, 239, 75, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(108, 239, 75, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
  }

  .rotate-x-75 {
    transform: rotateX(75deg);
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  /* Utility classes triggered by JS IntersectionObserver */
  .animate-in {
    opacity: 1 !important;
    transform: translateY(0) scale(1) !important;
    filter: blur(0px) !important;
  }

  /* Hide scrollbar for cleaner look in the main container, but keep functionality */
  main::-webkit-scrollbar {
    display: none;
  }
  main {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>

<script>
  // Intersection Observer for scroll-driven animations and Side Nav updates
  const scroller = document.getElementById('scroll-container');
  const sections = document.querySelectorAll('section');
  const navDots = document.querySelectorAll('.nav-dot');
  const portalThreads = document.getElementById('portal-threads');

  if (scroller && sections.length) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          
          // 1. Update side navigation active state
          navDots.forEach(dot => {
            if (dot.getAttribute('data-target') === entry.target.id) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });

          // 2. Trigger text/card animations inside the section
          const elementsToAnimate = entry.target.querySelectorAll('[data-animate]');
          elementsToAnimate.forEach(el => el.classList.add('animate-in'));

          // 3. Trigger special section animations
          if (entry.target.id === 'section-portal' && portalThreads) {
             portalThreads.classList.remove('opacity-0');
             portalThreads.classList.add('opacity-100');
          }
        }
      });
    }, {
      root: scroller,
      threshold: 0.4 // Trigger when 40% of the section is visible
    });

    sections.forEach(section => observer.observe(section));

    // Side navigation click smooth scroll
    navDots.forEach(dot => {
      dot.addEventListener('click', () => {
        const targetId = dot.getAttribute('data-target');
        const targetSection = document.getElementById(targetId);
        if (targetSection && scroller) {
          scroller.scrollTo({
            top: targetSection.offsetTop,
            behavior: 'smooth'
          });
        }
      });
    });

    // Back to top button
    const backToTop = document.getElementById('back-to-top');
    backToTop?.addEventListener('click', (e) => {
       e.preventDefault();
       scroller.scrollTo({
         top: 0,
         behavior: 'smooth'
       });
    });
  }
</script>
