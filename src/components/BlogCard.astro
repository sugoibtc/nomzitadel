---
interface Props {
  title: string;
  excerpt: string;
  date: string;
  category: string;
  slug: string;
  type?: string; 
  source?: string;
}

const { title, excerpt, date, category, slug, type = "RECAP", source } = Astro.props;
---

<a
  href={`/blog/${slug}`}
  class="group block bg-card/40 border border-white/5 rounded-xl p-5 sm:p-8 hover:border-neon-green/30 transition-all duration-300 backdrop-blur-sm relative overflow-hidden"
>
  <div class="absolute inset-0 bg-gradient-to-br from-neon-green/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
  
  <div class="flex items-center gap-2 mb-6">
    <span class="inline-block px-2 py-0.5 text-[10px] font-bold bg-neon-green text-bg rounded uppercase tracking-wider" style="font-family: system-ui, -apple-system, sans-serif;">
      {type}
    </span>
    <span class="text-[10px] uppercase tracking-[0.2em] text-text-dim/50 font-bold">
      {category}
    </span>
  </div>

  <h3 class="text-lg sm:text-2xl font-bold text-white mb-4 group-hover:text-neon-green transition-colors leading-tight">
    {title}
  </h3>
  
  <p class="hidden sm:-webkit-box sm:line-clamp-3 text-text-dim/70 mb-8 italic leading-relaxed" style="display: -webkit-box; -webkit-box-orient: vertical;">
    "{excerpt}"
  </p>

  <div class="flex items-center justify-between pt-6 border-t border-white/5">
    <div class="flex flex-col gap-1">
      <time class="text-text-dim/30 text-[10px] font-mono">{date}</time>
      {source && <span class="text-[10px] text-neon-green/60 font-medium">VIA {source.toUpperCase()}</span>}
    </div>
    <span class="text-neon-green group-hover:translate-x-2 transition-all p-2 bg-white/5 rounded-full border border-white/5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </span>
  </div>
</a>
