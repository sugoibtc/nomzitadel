---
export interface Props {
  title: string;
  reward: string;
  difficulty: string;
  category: string;
  link?: string;
}

const { title, reward, difficulty, category, link = "#" } = Astro.props;
---

<a href={link} class="block group p-5 rounded-lg bg-card/50 border border-neon-green/10 backdrop-blur-md hover:bg-card hover:border-neon-green/40 transition-all duration-300 relative overflow-hidden transform hover:-translate-y-1">
  <div class="absolute top-0 right-0 w-32 h-32 bg-neon-green/5 rounded-full blur-3xl -mr-16 -mt-16 group-hover:bg-neon-green/10 transition-colors duration-500"></div>
  
  <div class="flex justify-between items-start mb-4 relative z-10">
    <div class="flex gap-2">
      <span class="px-2 py-1 rounded text-xs font-medium bg-neon-green/10 text-neon-green border border-neon-green/20">{category}</span>
      <span class="px-2 py-1 rounded text-xs font-medium bg-white/5 text-text-dim border border-white/10">{difficulty}</span>
    </div>
    <div class="text-right">
      <div class="text-neon-green font-bold text-lg">{reward}</div>
    </div>
  </div>
  
  <h3 class="text-lg font-bold text-text-bright mb-2 group-hover:text-neon-green transition-colors relative z-10 line-clamp-2">{title}</h3>
  
  <div class="flex items-center text-sm font-medium text-text-dim mt-4 relative z-10 group-hover:text-text-bright transition-colors">
    <span>View Details <span class="text-neon-green ml-1 group-hover:translate-x-1 inline-block transition-transform">&rarr;</span></span>
  </div>
</a>
