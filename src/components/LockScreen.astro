---
// LockScreen.astro
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpg';
---

<div id="site-lock-screen" class="fixed inset-0 z-[9999] bg-black flex items-center justify-center min-h-screen cyber-grid">
  <!-- Dynamic radial glow -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(17,255,68,0.15)_0%,transparent_60%))] pointer-events-none"></div>

  <!-- The Floating Glowing Green Card -->
  <div class="relative z-10 w-full max-w-sm mx-6 animate-lock-in">
    <div class="bg-black/80 backdrop-blur-xl p-10 rounded-2xl border border-[#11FF44]/30 shadow-[0_0_50px_rgba(17,255,68,0.15)] flex flex-col items-center text-center transform transition-all duration-500 hover:shadow-[0_0_80px_rgba(17,255,68,0.3)] hover:border-[#11FF44]/60">
      
      <div class="w-20 h-20 rounded-full border border-[#11FF44]/30 flex items-center justify-center mb-6 shadow-[0_0_30px_rgba(17,255,68,0.2)] overflow-hidden transition-all duration-500 group-hover:shadow-[0_0_50px_rgba(17,255,68,0.4)] group-hover:border-[#11FF44]/60">
         <Image src={logo} alt="Zenon" class="w-full h-full object-cover" />
      </div>

      <h1 class="text-3xl font-black text-white tracking-tight mb-2 text-glow">
        3..2..1.. zoon
      </h1>
      
      <p class="text-text-dim text-xs mb-8 font-mono tracking-widest opacity-80">
        SYSTEM_LOCKED
      </p>

      <form id="lock-form" class="w-full flex flex-col items-center">
        <input 
          type="password" 
          id="lock-password" 
          placeholder="ENTER PASSWORD" 
          class="w-full bg-black/50 border border-white/10 rounded-lg px-4 py-3 text-center text-white focus:outline-none focus:border-[#11FF44] font-mono tracking-widest placeholder-white/20 transition-colors"
          autocomplete="off"
        />
        <button type="submit" class="mt-4 px-6 py-2 bg-[#11FF44]/10 border border-[#11FF44]/30 text-[#11FF44] font-mono text-xs tracking-[0.2em] rounded hover:bg-[#11FF44]/20 transition-colors uppercase w-full">
          Authenticate
        </button>
      </form>
      
      <p id="lock-error" class="text-red-500 text-xs mt-4 font-mono hidden opacity-0 transition-opacity">
        ACCESS_DENIED
      </p>
    </div>
  </div>
</div>

<script is:inline>
  // Hide lock screen immediately if authorized to prevent flash
  const TARGET_HASH = "c08c56cca7a12b674ab1369e0907a045be169830b317c7ffda6f62a262bd047c";
  const isAuthorized = localStorage.getItem('nomSiteAccess') === 'granted';
  
  const siteLockScreen = document.getElementById('site-lock-screen');
  if (isAuthorized && siteLockScreen) {
     siteLockScreen.style.display = 'none';
  }

  async function hashPassword(str) {
    const encoder = new TextEncoder();
    const data = encoder.encode(str);
    const hashBuffer = await crypto.subtle.digest('SHA-256', data);
    return Array.from(new Uint8Array(hashBuffer))
      .map(b => b.toString(16).padStart(2, '0'))
      .join('');
  }

  // Defer everything else until DOM is fully parsed
  window.addEventListener('DOMContentLoaded', () => {
    const lockScreen = document.getElementById('site-lock-screen');
    const lockForm = document.getElementById('lock-form');
    const passwordInput = document.getElementById('lock-password');
    const errorMsg = document.getElementById('lock-error');
    const appContent = document.getElementById('app-content');

    if (isAuthorized) {
      if (lockScreen) lockScreen.remove();
      if (appContent) {
        appContent.classList.remove('hidden', 'opacity-0');
        appContent.classList.add('opacity-100');
      }
      document.body.classList.remove('overflow-hidden');
    } else {
      document.body.classList.add('overflow-hidden');
      if (appContent) {
         appContent.classList.add('hidden', 'opacity-0');
      }
    }

    if (lockForm) {
      lockForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const inputVal = passwordInput ? passwordInput.value : '';
        const inputHash = await hashPassword(inputVal);

        if (inputHash === TARGET_HASH) {
          localStorage.setItem('nomSiteAccess', 'granted');
          lockScreen?.classList.add('opacity-0', 'pointer-events-none');
          setTimeout(() => {
            lockScreen?.remove();
            if (appContent) {
              appContent.classList.remove('hidden', 'opacity-0');
              appContent.classList.add('opacity-100');
            }
            document.body.classList.remove('overflow-hidden');
          }, 500);
        } else {
          if (passwordInput) {
            passwordInput.value = '';
            passwordInput.classList.add('border-red-500');
          }
          if (errorMsg) {
            errorMsg.classList.remove('hidden');
            errorMsg.classList.add('opacity-100');
          }
          setTimeout(() => {
            if (passwordInput) passwordInput.classList.remove('border-red-500');
            if (errorMsg) {
              errorMsg.classList.add('hidden');
              errorMsg.classList.remove('opacity-100');
            }
          }, 2000);
        }
      });
    }
  });
</script>

<style>
  @keyframes lock-fade-up {
    from { opacity: 0; transform: translateY(20px); filter: blur(4px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  .animate-lock-in {
    animation: lock-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  #site-lock-screen {
    transition: opacity 0.5s ease;
  }
</style>
